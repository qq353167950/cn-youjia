<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 数据源 qiyoujiage.com 仅提供 http，且无 https 证书链。
         这里只对该单一域名放开明文，其余全局仍强制 TLS。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">qiyoujiage.com</domain>
        <domain includeSubdomains="true">www.qiyoujiage.com</domain>
    </domain-config>
</network-security-config>
